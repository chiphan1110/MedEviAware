# For data processing
ROOT=/path/to/MedEviAware
RAW_DATA_DIR=${ROOT}/processed_data/raw
PROCESSED_DIR=${ROOT}/processed_data

# Models
BASE_MODEL_DIR=/path/to/Qwen2.5-3B-Instruct        # policy model
HELPER_MODEL_DIR=/path/to/Qwen2.5-7B-Instruct      # fact tagging, DiagBench option writing
TEACHER_MODEL_DIR=/path/to/Qwen2.5-14B-Instruct    # stronger-model labels (ablation)

# For training
LOG_DIR=${ROOT}/logs
WANDB_DIR=${ROOT}/wandb
RESULTS_DIR=${ROOT}/results
EVAL_RESULTS_DIR=${RESULTS_DIR}/eval_results

# For exporting FSDP checkpoints to HF format
RAW_CKPT_DIR=/path/to/raw_ckpt_dir
OUR_MODEL_DIR=/path/to/our_final_model_dir

# Secrets (never send MIMIC/DiagBench text to external APIs)
HF_TOKEN=
OPENAI_API_KEY=
